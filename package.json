{
  "name": "image-aleatoire",
  "productName": "Image aléatoire",
  "version": "1.2.1",
  "description": "Diaporama aléatoire d'un dossier d'images, avec défilement automatique",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "local.image.aleatoire",
    "files": [
      "main.js",
      "preload.js",
      "index.html"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ]
  },
  "dependencies": {
    "heic-convert": "^2.1.0",
    "yauzl": "^3.2.0"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.2.0"
  }
}
